#!/bin/bash

## Description: Lance les serveurs back + front au premier plan (logs lisibles, Ctrl+C pour arrêter)
## Usage: dev
## Example: "ddev dev"

echo "Arrêt des serveurs de fond…"
supervisorctl stop 'webextradaemons:*' >/dev/null 2>&1
# Libère 3000 (Vite) et 4000 (NestJS) si un lancement précédent a laissé des orphelins
fuser -k -TERM 3000/tcp 4000/tcp >/dev/null 2>&1
pkill -f "@nestjs/cli/bin/nest.js" >/dev/null 2>&1
pkill -f "vite/bin/vite.js" >/dev/null 2>&1
sleep 1

cd /var/www/html || exit 1

# "kill 0" termine tout le groupe de processus : pas d'orphelin qui garde
# les ports occupés après un Ctrl+C.
trap 'kill 0' EXIT INT TERM

echo "Serveurs lancés — Ctrl+C pour arrêter, puis 'ddev dev-restart' pour repasser en tâche de fond."
yarn dev:back &
yarn dev:front &
wait
